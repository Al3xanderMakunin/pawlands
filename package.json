{
  "name": "pawlands",
  "version": "1.2.0",
  "private": true,
  "description": "Open-source multiplayer 2D pixel-art survival RPG featuring cats, an open world, real-time PvP, quests, crafting, and exploration.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:client": "pnpm --filter @pawlands/client dev",
    "dev:server": "pnpm --filter @pawlands/server dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
